  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8A6F66", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#6A9955" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["constant.language", "support.constant"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#E8D9C7" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#FF7B1C", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#4A9EFF" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": { "foreground": "#F0C84A" }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#F0C84A" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#A470E0", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#D4C4B0" }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export"],
      "settings": { "foreground": "#5CD0D8" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#4A9EFF" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FF7B1C", "fontStyle": "italic" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.bracket"],
      "settings": { "foreground": "#D4C4B0" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF4A3A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#C8201E", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "markup.link"],
      "settings": { "foreground": "#4A9EFF", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6A9955" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#C8201E" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": { "foreground": "#6A9955" }
    },
    {
      "scope": ["markup.list"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8A6F66", "fontStyle": "italic" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["meta.annotation"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#FF7B1C" }
    },
    {
      "scope": ["entity.name.variable.field", "variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#E8D9C7" }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": { "foreground": "#4A9EFF" }
    },
    {
      "scope": ["source.clojure meta.symbol", "source.clojure variable"],
      "settings": { "foreground": "#E8D9C7" }
    },
    {
      "scope": ["source.clojure keyword"],
      "settings": { "foreground": "#A470E0", "fontStyle": "bold" }
    },
    {
      "scope": ["source.clojure constant.keyword"],
      "settings": { "foreground": "#FF7B1C" }
    }
  ]
}
